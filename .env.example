# Скопируйте этот файл в .env и подставьте значения из Supabase:
# Project Settings -> API -> Project URL и anon public key.
# anon-ключ предназначен для публичного использования: данные защищены правилами RLS из supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Ключ Gemini API для серверной генерации заданий «Корректор» (необязательно — без него работает офлайн-режим):
GEMINI_API_KEY=

# Необязательные ключи VAPID для фоновых Web Push (если не заданы, сервер создаст их автоматически в .data/push-store.json):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

